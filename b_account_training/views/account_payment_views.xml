<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- account.payment inherit form view -->
    <record id="account_payment_view_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.view.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_training_payment" groups="b_account_training.user_account_training"
                    readonly="reconciled_invoices_count &gt; 0 or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>