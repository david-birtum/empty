<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- account.move inherit form view -->
    <record id="account_move_view_form_inherit" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="is_training_readonly" invisible="1"/>
                <field name="is_training_invoice" groups="b_account_training.user_account_training"
                       readonly="is_training_readonly != False"/>
            </xpath>
        </field>
    </record>

    <!-- account.move inherit search view -->
    <record id="account_move_view_search_inherit" model="ir.ui.view">
        <field name="name">account.move.view.search.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_check']" position="after">
                <filter string="Training invoices" name="training" domain="[('is_training_invoice','=',True)]"
                    groups="b_account_training.user_account_training"/>
            </xpath>
        </field>
    </record>
</odoo>