<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- sale.order inherit form view -->
    <record id="sale_order_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_header']/group[@name='order_details']" position="inside">
                <field name="is_training_sale"
                       readonly="state not in ('draft', 'sent')"
                       groups="b_account_training.user_account_training"/>
            </xpath>
        </field>
    </record>
    <!-- sale.order inherit search view -->
    <record id="sale_order_view_search_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='sales']" position="after">
                <separator/>
                <filter string="Training Orders" name="training" domain="[('is_training_sale','=',True)]"
                    groups="b_account_training.user_account_training"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_product_search_inherit" model="ir.ui.view">
        <field name="name">sale.order.product.search.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='industry_id']" position="after">
                <separator/>
                <filter string="Training Orders" name="training" domain="[('is_training_sale','=',True)]"
                    groups="b_account_training.user_account_training"/>
            </xpath>
        </field>
    </record>
</odoo>